FROM nvidia/cuda:12.6.3-devel-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./

# Install torch from the CUDA wheel index
ENV UV_TORCH_BACKEND=cu126
RUN uv sync --frozen --no-dev --python 3.12

COPY training /app/training
COPY models /app/models
COPY download_and_tokenise.py /app/download_and_tokenise.py
COPY main.py /app/main.py

ENV PATH="/app/.venv/bin:$PATH"

# Entrypoint will be set on K8s.