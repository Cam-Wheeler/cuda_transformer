FROM nvidia/cuda:12.6.3-devel-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./

# Install torch from the CUDA wheel index
ENV UV_TORCH_BACKEND=cu126

# Install ncu (Nsight Compute CLI)
RUN apt-get update && apt-get install -y --no-install-recommends \
    cuda-nsight-compute-12-6 \
    && rm -rf /var/lib/apt/lists/*

# deb installs land under a versioned dir, not always on PATH
RUN NCU_HOME=$(find /opt/nvidia/nsight-compute -mindepth 1 -maxdepth 1 -type d | head -n1) \
    && test -x "$NCU_HOME/ncu" \
    && ln -s "$NCU_HOME" /opt/nvidia/nsight-compute/current
ENV PATH="/opt/nvidia/nsight-compute/current:${PATH}"

# Create the venv and install deps.
RUN uv sync --no-dev --frozen --python 3.12

# CUDA source code
COPY cudasrc /app/cudasrc 

# Handle the setup so we compile on image build
# This will insert the .so file into the image.
COPY setup.py /app/setup.py
RUN uv run python /app/setup.py build_ext --inplace

# Python wrappers around C++
COPY wrappers /app/wrappers

# Profiling code, import layer 2 into /app.
COPY profiling/setup_kernels.py /app/setup_kernels.py
COPY profiling/layer_one_or_two_bench.py /app/layer_one_or_two_bench.py
COPY profiling/launch_ncu.sh /app/launch_ncu.sh

ENV PATH="/app/.venv/bin:$PATH"

# Entrypoint will be set on K8s.