  # Python
  __pycache__/
  *.py[cod]
  .venv/

  # Build artifacts - these are generated by setup.py, not source
  build/
  dist/
  *.egg-info/
  *.so          # the compiled CUDA extensions
  *.pyd

  # CUDA compilation cache
  .cache/

  # Checkpoints - too large for git
  checkpoints/

  # Data files - downloaded at runtime
  *.txt
  wizard_of_oz.txt
  vocab.txt

  # OS
  .DS_Store
